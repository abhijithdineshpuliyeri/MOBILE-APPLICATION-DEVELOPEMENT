<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available Books"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="25dp"/>


        <!-- Book 1 -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Alchemist"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paulo Coelho"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/issueAlchemist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Issue Book"
            android:layout_marginBottom="20dp"/>


        <!-- Book 2 -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atomic Habits"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="James Clear"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/issueAtomic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Issue Book"
            android:layout_marginBottom="20dp"/>


        <!-- Book 3 -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clean Code"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Robert C. Martin"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/issueCleanCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Issue Book"
            android:layout_marginBottom="20dp"/>


        <!-- Book 4 -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Harry Potter"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="J. K. Rowling"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/issueHarry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Issue Book"
            android:layout_marginBottom="20dp"/>


        <!-- Book 5 -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rich Dad Poor Dad"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Robert Kiyosaki"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/issueRichDad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Issue Book"/>

    </LinearLayout>

</ScrollView>